{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "authRoute": {
        "ClusterId": "authCluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "api/auth/{**catch-all}" }
        ]
      },
      "searchRoute": {
        "ClusterId": "searchCluster",
        "Match": {
          "Path": "/api/flightsearch/{**catch-all}"
        }
      },
      "passengerRoute": {
        "ClusterId": "passengerCluster",
        "Match": {
          "Path": "/api/passenger/{**catch-all}"
        }
      },
      "staffRoute": {
        "ClusterId": "staffCluster",
        "Match": {
          "Path": "/api/schedule/{**catch-all}"
        }
      },
      "manifestRoute": {
        "ClusterId": "staffCluster",
        "Match": {
          "Path": "/api/manifest/{**catch-all}"
        }
      },
      "adminRoute": {
        "ClusterId": "adminCluster",
        "Match": {
          "Path": "/api/airport/{**catch-all}"
        }
      },
      "airlineRoute": {
        "ClusterId": "adminCluster",
        "Match": {
          "Path": "/api/airline/{**catch-all}"
        }
      },
      "revenueRoute": {
        "ClusterId": "adminCluster",
        "Match": {
          "Path": "/api/revenue/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "authCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://auth-api:8080"
          }
        }
      },
      "searchCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://flight-search-api:8080"
          }
        }
      },
      "passengerCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://passenger-api:8080"
          }
        }
      },
      "staffCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://staff-operations-api:8080"
          }
        }
      },
      "adminCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://admin-api:8080"
          }
        }
      }
    }
  }
}

