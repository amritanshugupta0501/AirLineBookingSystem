{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "authRoute": {
        "ClusterId": "authCluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "{**catch-all}" }
        ]
      },
      "searchRoute": {
        "ClusterId": "searchCluster",
        "Match": {
          "Path": "/api/flightsearch/{**catch-all}"
        }
      },
      "passengerRoute": {
        "ClusterId": "passengerCluster",
        "Match": {
          "Path": "/api/passenger/{**catch-all}"
        }
      },
      "staffRoute": {
        "ClusterId": "staffCluster",
        "Match": {
          "Path": "/api/schedule/{**catch-all}"
        }
      },
      "manifestRoute": {
        "ClusterId": "staffCluster",
        "Match": {
          "Path": "/api/manifest/{**catch-all}"
        }
      },
      "adminRoute": {
        "ClusterId": "adminCluster",
        "Match": {
          "Path": "/api/airport/{**catch-all}"
        }
      },
      "airlineRoute": {
        "ClusterId": "adminCluster",
        "Match": {
          "Path": "/api/airline/{**catch-all}"
        }
      },
      "revenueRoute": {
        "ClusterId": "adminCluster",
        "Match": {
          "Path": "/api/revenue/{**catch-all}"
        }
      },
      "foodOrderRoute": {
        "ClusterId": "foodOrderCluster",
        "Match": {
          "Path": "/api/foodorder/{**catch-all}"
        }
      },
      "foodInventoryRoute": {
        "ClusterId": "foodInventoryCluster",
        "Match": {
          "Path": "/api/foodinventory/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "authCluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:5001"
          }
        }
      },
      "searchCluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:5005"
          }
        }
      },
      "passengerCluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:5007"
          }
        }
      },
      "staffCluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:5008"
          }
        }
      },
      "adminCluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:5009"
          }
        }
      },
      "foodOrderCluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:5010"
          }
        }
      },
      "foodInventoryCluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:5011"
          }
        }
      }
    }
  }
}
